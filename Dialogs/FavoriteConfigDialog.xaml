<Window x:Class="Symphonia.Dialogs.FavoriteConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Favorite Configuration"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        MinWidth="280"
        MinHeight="160">
    <Border Padding="16">
        <StackPanel>
            <TextBlock Text="What would you like to do with your favorite songs?"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>
            <TextBlock Text="Export saves the current favorites to a .symphofs file."
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"/>
            <TextBlock Text="Import loads favorites from a .symphofs file."
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>
            <UniformGrid Columns="2" Rows="1" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                <Button x:Name="ExportButton" Content="Export" Margin="0,0,8,0" MinHeight="32" Click="ExportButton_Click"/>
                <Button x:Name="ImportButton" Content="Import" Margin="8,0,0,0" MinHeight="32" Click="ImportButton_Click"/>
            </UniformGrid>
            <Button Content="Cancel" IsCancel="True" HorizontalAlignment="Right" Width="80" MinHeight="28"/>
        </StackPanel>
    </Border>
</Window>
