<Window x:Class="Symphonia.Dialogs.FavoriteImportModeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Favorites"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        MinWidth="300"
        MinHeight="180">
    <Border Padding="16">
        <StackPanel>
            <TextBlock Text="How should the imported favorites be handled?"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>
            <TextBlock x:Name="ImportSummaryText"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>
            <TextBlock Text="Expand keeps existing favorites and adds new songs without duplicates."
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"/>
            <TextBlock Text="Overwrite replaces the current favorites with the imported list."
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>
            <UniformGrid Columns="2" Rows="1" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                <Button x:Name="ExpandButton" Content="Expand" Margin="0,0,8,0" MinHeight="32" Click="ExpandButton_Click"/>
                <Button x:Name="OverwriteButton" Content="Overwrite" Margin="8,0,0,0" MinHeight="32" Click="OverwriteButton_Click"/>
            </UniformGrid>
            <Button Content="Cancel" IsCancel="True" HorizontalAlignment="Right" Width="80" MinHeight="28"/>
        </StackPanel>
    </Border>
</Window>
